{
  "openapi": "3.0.1",
  "info": {
    "title": "AppForMovies.API",
    "description": "This API provides services for renting and purchasing movies",
    "contact": {
      "name": "Software Engineering II Team",
      "email": "isii@on.uclm.es"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/license/mit/"
    },
    "version": "v1"
  },
  "paths": {
    "/api/Devices/GetDispositivosParaComprar": {
      "get": {
        "tags": [
          "Devices"
        ],
        "operationId": "GetDispositivosParaComprar",
        "parameters": [
          {
            "name": "filtroNombre",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filtroColor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceForPurchaseDTO"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceForPurchaseDTO"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceForPurchaseDTO"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Purchases/GetPurchaseDetail": {
      "get": {
        "tags": [
          "Purchases"
        ],
        "operationId": "GetPurchaseDetail",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/purchaseDetailDTO"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/purchaseDetailDTO"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/purchaseDetailDTO"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Purchases/CrearCompra": {
      "post": {
        "tags": [
          "Purchases"
        ],
        "operationId": "CrearCompra",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/purchaseForCreateDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/purchaseForCreateDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/purchaseForCreateDTO"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/purchaseDetailDTO"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/purchaseDetailDTO"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/purchaseDetailDTO"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Device": {
        "required": [
          "Brand",
          "Color",
          "Model",
          "Name",
          "PriceForPurchase",
          "QuantityForPurchase",
          "Year"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Model": {
            "$ref": "#/components/schemas/Model"
          },
          "Brand": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "Color": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "Name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "PriceForPurchase": {
            "type": "number",
            "format": "double"
          },
          "QuantityForPurchase": {
            "type": "integer",
            "format": "int32"
          },
          "Year": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "DeviceForPurchaseDTO": {
        "required": [
          "Brand",
          "Color",
          "Model",
          "NameDevice",
          "PriceForPurchase"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "NameDevice": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "Brand": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "Model": {
            "$ref": "#/components/schemas/Model"
          },
          "Color": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "PriceForPurchase": {
            "minimum": 0.5,
            "type": "number",
            "format": "currency"
          }
        },
        "additionalProperties": false
      },
      "Model": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Name": {
            "maxLength": 50,
            "minLength": 4,
            "type": "string",
            "nullable": true
          },
          "Devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Device"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PaymentMethodTypes": {
        "enum": [
          "CreditCard",
          "PayPal",
          "Cash"
        ],
        "type": "string"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "purchaseDetailDTO": {
        "required": [
          "DeliveryAddress",
          "PurchaseDateFrom",
          "TotalPrice",
          "TotalQuantity"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 40,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "surename": {
            "maxLength": 40,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "DeliveryAddress": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "PurchaseDateFrom": {
            "type": "string",
            "format": "date"
          },
          "TotalPrice": {
            "minimum": 0.5,
            "type": "number",
            "format": "currency"
          },
          "TotalQuantity": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "currency"
          },
          "PurchaseItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/purchaseItemDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "purchaseForCreateDTO": {
        "required": [
          "CustomerNameSurname",
          "CustomerUserName",
          "DeliveryAddress",
          "PaymentMethod"
        ],
        "type": "object",
        "properties": {
          "DeliveryAddress": {
            "maxLength": 50,
            "minLength": 4,
            "type": "string",
            "format": "multiline"
          },
          "CustomerUserName": {
            "minLength": 1,
            "type": "string"
          },
          "CustomerNameSurname": {
            "maxLength": 50,
            "minLength": 4,
            "type": "string"
          },
          "PurchaseItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/purchaseItemDTO"
            },
            "nullable": true
          },
          "PaymentMethod": {
            "$ref": "#/components/schemas/PaymentMethodTypes"
          },
          "Quantity": {
            "type": "integer",
            "format": "int32"
          },
          "DateTime": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "purchaseItemDTO": {
        "type": "object",
        "properties": {
          "Brand": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "Model": {
            "type": "string",
            "nullable": true
          },
          "Color": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string",
            "nullable": true
          },
          "Price": {
            "minimum": 0.5,
            "type": "number",
            "format": "currency"
          },
          "Description": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "Quantity": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}