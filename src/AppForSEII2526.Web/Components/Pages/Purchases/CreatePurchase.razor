@page "/Purchases/CreatePurchase"
@using System.Net
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web
@inject PurchasesStateContainer CompraState
@inject AppForSEII2526APIClient ApiClient
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Finalizar Compra</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-7">


            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
                    <div>
                        <strong>Atención:</strong> @mensajeError
                    </div>
                </div>
            }

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h4 class="mb-0"><i class="bi bi-person-lines-fill"></i> Datos de Envío</h4>
                </div>
                <div class="card-body">


                    <EditForm Model="CompraState.Purchase" OnSubmit="ProcesarPedido">

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label class="form-label">Nombre *</label>
                                <InputText id="InputNombre" @bind-Value="CompraState.Purchase.CustomerUserName" class="form-control" placeholder="Ej. Juan" />
                            </div>

                            <div class="col-sm-6">
                                <label class="form-label">Apellidos *</label>
                                <InputText id="InputApellidos" @bind-Value="CompraState.Purchase.CustomerNameSurname" class="form-control" placeholder="Ej. Pérez" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Dirección de Entrega *</label>
                                <InputText id="InputDireccion" @bind-Value="CompraState.Purchase.DeliveryAddress" class="form-control" placeholder="Calle, número, ciudad..." />
                            </div>


                            <div class="col-12">
                                <label class="form-label">Método de Pago *</label>
                                <InputSelect id="InputPago" @bind-Value="CompraState.Purchase.PaymentMethod" class="form-select">
                                    @foreach (var metodo in Enum.GetValues(typeof(PaymentMethodTypes)))
                                    {
                                        <option value="@metodo">@metodo</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex gap-2">
                            <a href="/Purchases/SelectDevices" class="btn btn-secondary w-50 btn-lg">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>

                            <button class="btn btn-success w-50 btn-lg" type="submit" disabled="@enviando">
                                @if (enviando)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                    <span> Procesando...</span>
                                }
                                else
                                {
                                    <span><i class="bi bi-check-circle"></i> Confirmar</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-cart3"></i> Tu Pedido</h4>
                </div>
                <div class="card-body">
                    @if (CompraState.Purchase.PurchaseItems == null || !CompraState.Purchase.PurchaseItems.Any())
                    {
                        <div class="alert alert-warning">Tu carrito está vacío.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var item in CompraState.Purchase.PurchaseItems)
                            {
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between lh-sm">
                                        <div>
                                            <h6 class="my-0">@item.Brand @item.Model</h6>
                                            <small class="text-muted">@item.Color (x @item.Quantity)</small>
                                            <div class="col-12">
                                                <label class="form-label">Descripcion*</label>
                                                <InputText id="descripcion" @bind-Value="item.Description" class="form-control" placeholder="Compra web..." />
                                            </div>
                                        </div>
                                        <span class="text-muted">@((item.Price * item.Quantity).ToString("C2"))</span>
                                    </div>
                                </li>
                            }
                        </ul>
                        <div class="d-flex justify-content-between p-3 bg-light rounded">
                            <span class="h5">Total (EUR)</span>
                            <strong class="h4">@CompraState.TotalPrice.ToString("C2")</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool enviando = false;
    private string mensajeError = "";

    protected override void OnInitialized()
    {
        // Si el carrito está vacío se redirige al paso anterior
        if (CompraState.Purchase.PurchaseItems == null || !CompraState.Purchase.PurchaseItems.Any())
        {
            Navigation.NavigateTo("/Purchases/SelectDevices");
        }
    }

    private async Task ProcesarPedido()
    {
        mensajeError = "";

        // ==========================================================
        // 1. CONTROL DE CAMPOS VACÍOS (Frontend)
        // ==========================================================
        if (string.IsNullOrWhiteSpace(CompraState.Purchase.CustomerUserName))
        {
            mensajeError = "Por favor, introduce tu Nombre.";
            return;
        }
        if (string.IsNullOrWhiteSpace(CompraState.Purchase.CustomerNameSurname))
        {
            mensajeError = "Por favor, introduce tus Apellidos.";
            return;
        }
        if (string.IsNullOrWhiteSpace(CompraState.Purchase.DeliveryAddress))
        {
            mensajeError = "Es obligatorio introducir una Dirección de entrega.";
            return;
        }

        // ==========================================================
        // 2. REGLA OBLIGATORIA: El nombre tiene que tener formato Email
        // ==========================================================
        if (!CompraState.Purchase.CustomerUserName.Contains("@"))
        {
            mensajeError = "El Nombre de registro debe ser un email válido.";
            return;
        }

        // ==========================================================
        // 3. CONTROL DE LONGITUDES MÁXIMAS (Frontend)
        // ==========================================================
        if (CompraState.Purchase.CustomerUserName.Length > 50)
        {
            mensajeError = "El Nombre es demasiado largo (máximo 50 caracteres).";
            return;
        }
        if (CompraState.Purchase.CustomerNameSurname.Length > 70)
        {
            mensajeError = "Los Apellidos son demasiado largos (máximo 70 caracteres).";
            return;
        }
        if (CompraState.Purchase.DeliveryAddress.Length > 100)
        {
            mensajeError = "La Dirección es demasiado larga (máximo 100 caracteres).";
            return;
        }

        // ==========================================================
        // 4. ENVÍO DE DATOS Y CONTROL DE STOCK (API)
        // ==========================================================
        enviando = true;

        try
        {
            // Forzamos el método de pago (0 = CreditCard, Cash, etc.)
            CompraState.Purchase.PaymentMethod = 0;

            // Recalculamos cantidades y asignamos fecha de proceso
            CompraState.Purchase.Quantity = CompraState.Purchase.PurchaseItems.Sum(i => i.Quantity);
            CompraState.Purchase.DateTime = DateTime.Now;

            // Lanzamos la petición al servidor
            var compraRealizada = await ApiClient.CrearCompraAsync(CompraState.Purchase);

            // Si el servidor da el OK, avanzamos al recibo final
            Navigation.NavigateTo($"/Purchases/DetailPurchase/{compraRealizada.Id}");
        }
        catch (AppForSEII2526.Web.API.ApiException ex)
        {
            // Gracias a la traza larga sabemos que la excepción es de tipo ApiException<ValidationProblemDetails>
            // Usamos el patrón de coincidencia nativo de C# para abrir el objeto sin romper nada
            if (ex is AppForSEII2526.Web.API.ApiException<AppForSEII2526.Web.API.ValidationProblemDetails> validationEx)
            {
                if (validationEx.Result?.Errors != null)
                {
                    // Recorremos el diccionario de errores del ModelState que envió tu API
                    foreach (var error in validationEx.Result.Errors)
                    {
                        foreach (var mensaje in error.Value)
                        {
                            string msgTexto = mensaje.ToString();

                            // 1. CAPTURAMOS EL ERROR DE USUARIO NO EXISTE (CU1_10)
                            if (msgTexto.Contains("Usuario no registrado"))
                            {
                                mensajeError = "El usuario no existe.";
                                return;
                            }

                            // 2. CAPTURAMOS EL ERROR DE DISPOSITIVO SIN STOCK (CU1_11)
                            if (msgTexto.Contains("No hay suficiente stock") || msgTexto.Contains("DispositivoNoDisponible"))
                            {
                                mensajeError = "No hay stock suficiente para el dispositivo seleccionado.";
                                return;
                            }
                        }
                    }
                }
            }

            // Fallback de seguridad: Si el error 400 es por otra cosa o es un error 500, muestra el código numérico
            mensajeError = $"Atención: Ocurrió un error al procesar la compra (Status: {ex.StatusCode}).";
        }
    }
}